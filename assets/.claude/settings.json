{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(**/.git/**)",
      "Write(.git/**)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)"
    ]
  },
  "teammateMode": "auto",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/refresh_status.py"
          }
        ]
      }
    ]
  }
}
